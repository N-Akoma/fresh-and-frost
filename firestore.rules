rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Product Security
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.category is string
        && data.stock is number && data.stock >= 0
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('image' in data) || (data.image is string && data.image.size() <= 1000));
    }

    // Order Security
    match /orders/{orderId} {
      // Only admins can list orders
      allow list: if isAdmin();
      // Only admins can get specific orders
      allow get: if isAdmin();
      
      // Anyone can create an order (WhatsApp first flow, but we store it for tracking)
      allow create: if isValidOrder(incoming());
      
      // Only admins can update status
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus'])
      );
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'confirmed', 'delivered', 'cancelled']
        && data.createdAt == request.time;
    }

    // Category Security
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin Security
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Admins must be provisioned manually or via console
    }
  }
}
